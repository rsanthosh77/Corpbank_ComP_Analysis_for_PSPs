# Copy to .env; the runner loads it automatically. Exported variables take precedence.
TAVILY_API_KEY=
NEBIUS_API_KEY=
NEBIUS_MODEL=zai-org/GLM-5.3
NEBIUS_API_BASE=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MAX_TOKENS=32768
NEBIUS_REASONING_EFFORT=low
NEBIUS_TIMEOUT_SECONDS=600
NEBIUS_CONNECT_TIMEOUT_SECONDS=15
NEBIUS_MAX_RETRIES=1
RESEARCH_STAGE_TIMEOUT_SECONDS=3600
RESEARCH_CONCURRENCY=2
RESEARCH_RECURSION_LIMIT=100
RESEARCH_SEARCHES_PER_WORKER=12
RESEARCH_MAX_SEARCH_REQUESTS=200
RESEARCH_MAX_MODEL_REQUESTS=150
